# ==============================================================================
# GMA-DEV (Get My Alert, Developer) - Configuration Environment Variables (.env.example)
# Do NOT commit actual secrets to version control.
# ==============================================================================

# --- System & Security Settings ---
APP_NAME=GMA-DEV
ENVIRONMENT=production
LOG_LEVEL=INFO
AUDIT_LOG_PATH=/app/audit_logs/incidents.jsonl
MASK_PII_ENABLED=true

# --- Server / Webhook Receiver Settings ---
PORT=8080
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:8080
WEBHOOK_SECRET=your-random-hmac-secret-string-here

# --- Output Channels: Discord ---
DISCORD_ENABLED=true
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1234567890/your-discord-token-here

# --- Output Channels: Telegram ---
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz
TELEGRAM_CHAT_ID=-1001234567890

# --- Output Channels: WhatsApp (Meta Cloud API / Twilio Adapter) ---
WHATSAPP_ENABLED=false
# Options: meta (default official Cloud API) or twilio
WHATSAPP_PROVIDER=meta
# Meta Cloud API settings:
WHATSAPP_PHONE_NUMBER_ID=109876543210987
WHATSAPP_ACCESS_TOKEN=EAAG...your-meta-access-token
WHATSAPP_RECIPIENT_PHONE=+56912345678
WHATSAPP_TEMPLATE_NAME=incident_alert_v1
# Twilio alternative settings (if WHATSAPP_PROVIDER=twilio):
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=+14155238886

# --- Integrations: Microsoft Clarity API ---
CLARITY_ENABLED=true
CLARITY_API_TOKEN=your-microsoft-clarity-api-token
CLARITY_PROJECT_ID=your-clarity-project-id
CLARITY_CHECK_INTERVAL_MINUTES=60

# --- Proactive Healthcheck Targets (JSON formatted list of URLs to monitor) ---
# Syntax: [{"name": "API Gateway", "url": "https://api.empresa.cl/healthz", "interval_seconds": 60, "expected_status": 200}]
MONITORED_TARGETS='[{"name":"Main API Gateway","url":"https://httpbin.org/status/200","interval_seconds":60,"expected_status":200}]'

# --- Plugins: AI Incident Enrichment (Optional) ---
AI_ENRICHER_ENABLED=false
# Options: ollama (local/offline, private), openai, gemini
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIzaSy...
